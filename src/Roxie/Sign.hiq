--
-- Part of ROXIE, a log collector on Wolly.
--
-- SPDX-FileCopyrightText: 2026 Heiko Zimmermann
-- SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
--
import Standard.String (
    String,
    fromSpan,
    destroyString
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeString,
    finalize
);
import Standard.Text (
    substring
);
import Standard.Database (
    Database,
    Writing,
    DbError,
    Cursor,
    noValues,
    withText,
    execute,
    start,
    advance,
    columnText,
    finish
);
import Wolly.Rambo (
    RamboConfig,
    makeRamboConfig
);
import Wolly.Auth (
    isUserName
);

module body Roxie.Sign is
    constant sub_longest: Index := 255;
    constant make_table: Span[Nat8, Static] := "CREATE TABLE IF NOT EXISTS roxie_rambo (sub TEXT PRIMARY KEY, name TEXT NOT NULL) STRICT";
    constant put_binding: Span[Nat8, Static] := "INSERT INTO roxie_rambo (sub, name) VALUES (?, ?) ON CONFLICT (sub) DO UPDATE SET name = excluded.name";
    constant get_binding: Span[Nat8, Static] := "SELECT name FROM roxie_rambo WHERE sub = ?";
    constant drop_bindings: Span[Nat8, Static] := "DELETE FROM roxie_rambo WHERE name = ?";

    function subMost(): Index is
        return sub_longest;
    end;

    generic [S: Region]
    function isSub(sub: Span[Nat8, S]): Bool is
        let size: Index := spanLength(sub);
        if (size = 0) or (size > sub_longest) then
            return false;
        end if;
        var i: Index := 0;
        while i < size do
            if (sub[i] < 33) or (sub[i] > 126) then
                return false;
            end if;
            i := i + 1;
        end while;
        return true;
    end;

    -- Whether text from first to before stop is word.
    generic [T: Region]
    function wordAt(text: Span[Nat8, T], first: Index, stop: Index, word: Span[Nat8, Static]): Bool is
        if (stop - first) /= spanLength(word) then
            return false;
        end if;
        var i: Index := 0;
        while i < spanLength(word) do
            if text[first + i] /= word[i] then
                return false;
            end if;
            i := i + 1;
        end while;
        return true;
    end;

    -- Where the value of the setting name is in text: its first byte and
    -- the byte after it; None when name is not there, is there twice, or
    -- text has a line of an unknown setting.
    generic [T: Region]
    function settingAt(text: Span[Nat8, T], name: Span[Nat8, Static]): Option[Index] is
        let size: Index := spanLength(text);
        var found: Index := 0;
        var count: Index := 0;
        var at: Index := 0;
        while at < size do
            var stop: Index := at;
            while (stop < size) and (text[stop] /= 10) do
                stop := stop + 1;
            end while;
            if (stop > at) and (text[at] /= '#') then
                var space: Index := at;
                while (space < stop) and (text[space] /= ' ') do
                    space := space + 1;
                end while;
                let known: Bool := ((wordAt(text, at, space, "issuer") or wordAt(text, at, space, "client")) or wordAt(text, at, space, "redirect")) or wordAt(text, at, space, "ca");
                if (not known) or (space >= stop) then
                    return None();
                end if;
                if wordAt(text, at, space, name) then
                    count := count + 1;
                    found := space + 1;
                end if;
            end if;
            at := stop + 1;
        end while;
        if count /= 1 then
            return None();
        end if;
        return Some(value => found);
    end;

    -- The end of the line that begins at first.
    generic [T: Region]
    function lineEnd(text: Span[Nat8, T], first: Index): Index is
        var stop: Index := first;
        while (stop < spanLength(text)) and (text[stop] /= 10) do
            stop := stop + 1;
        end while;
        return stop;
    end;

    generic [T: Region, S: Region]
    function readSignConfig(text: Span[Nat8, T], secret: Span[Nat8, S]): Option[RamboConfig] is
        case settingAt(text, "issuer") of
            when None do
                return None();
            when Some(value as issuer: Index) do
                case settingAt(text, "client") of
                    when None do
                        return None();
                    when Some(value as client: Index) do
                        case settingAt(text, "redirect") of
                            when None do
                                return None();
                            when Some(value as redirect: Index) do
                                case settingAt(text, "ca") of
                                    when None do
                                        return None();
                                    when Some(value as ca: Index) do
                                        return makeRamboConfig(substring(text, issuer, lineEnd(text, issuer)), substring(text, client, lineEnd(text, client)),
                                                               secret, substring(text, redirect, lineEnd(text, redirect)), substring(text, ca, lineEnd(text, ca)));
                                end case;
                        end case;
                end case;
        end case;
    end;

    generic [T: Region]
    function signedOutUri(text: Span[Nat8, T]): Option[String] is
        case settingAt(text, "redirect") of
            when None do
                return None();
            when Some(value as first: Index) do
                let stop: Index := lineEnd(text, first);
                if (stop - first) < 9 then
                    return None();
                end if;
                if not wordAt(text, first, first + 8, "https://") then
                    return None();
                end if;
                var host: Index := first + 8;
                while (host < stop) and (text[host] /= '/') do
                    host := host + 1;
                end while;
                var out: StringBuilder := makeStringBuilder();
                writeString(&!out, substring(text, first, host));
                writeString(&!out, "/signed-out");
                return Some(value => finalize(out));
        end case;
    end;

    generic [R: Region]
    function prepareSign(db: &![Database[Writing], R]): Option[DbError] is
        case execute(&~db, make_table, noValues()) of
            when Left(left as error: DbError) do
                return Some(value => error);
            when Right(right as made: Nat64) do
                return None();
        end case;
    end;

    generic [R: Region, S: Region, N: Region]
    function bindSub(db: &![Database[Writing], R], sub: Span[Nat8, S], name: Span[Nat8, N]): Either[DbError, Bool] is
        if (not isSub(sub)) or (not isUserName(name)) then
            let refused: Either[DbError, Bool] := Right(right => false);
            return refused;
        end if;
        case execute(&~db, put_binding, withText(withText(noValues(), sub), name)) of
            when Left(left as error: DbError) do
                return Left(left => error);
            when Right(right as put: Nat64) do
                return Right(right => true);
        end case;
    end;

    generic [R: Region, S: Region]
    function userOfSub(db: &![Database[Writing], R], sub: Span[Nat8, S]): Either[DbError, Option[String]] is
        var cursor: Cursor := start(&~db, get_binding, withText(noValues(), sub));
        let had: Bool := advance(&!cursor);
        var name: String := fromSpan("");
        if had then
            destroyString(name);
            name := fromSpan(columnText(&cursor, 0));
        end if;
        case finish(&~db, cursor) of
            when Some(value as error: DbError) do
                destroyString(name);
                return Left(left => error);
            when None do
                if had then
                    let some: Option[String] := Some(value => name);
                    return Right(right => some);
                end if;
                destroyString(name);
                let none: Option[String] := None();
                return Right(right => none);
        end case;
    end;

    generic [R: Region, N: Region]
    function unbindUser(db: &![Database[Writing], R], name: Span[Nat8, N]): Either[DbError, Nat64] is
        return execute(&~db, drop_bindings, withText(noValues(), name));
    end;
end module body.
